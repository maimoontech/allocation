# MPSS backend environment configuration.
#
# Copy this file to `backend/.env` and fill in real values for local development.
# `backend/.env` is gitignored and must never be committed.
# Deployed environments must set these in the hosting provider's environment
# configuration (e.g. Render dashboard), not in a file.
#
# The application refuses to start if any required variable is missing.

# --- Database (all required) ---
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# --- Auth (JWT_SECRET required) ---
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing this value invalidates every issued access token and forces all users to log in again.
JWT_SECRET=
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# --- Server (optional, defaults shown) ---
PORT=4000

# Comma-separated allow-list. Defaults to the known production and local origins
# when unset; override to change which frontends may call this API.
# CORS_ALLOWED_ORIGINS=https://example.com,http://localhost:5173

# --- Member login throttling (all optional, defaults shown) ---
# Applies to the member role ONLY. The four existing roles' login path is unthrottled,
# exactly as before this module; changing that was not part of the request.
#
# The two counters are independent. A member's own failures lock only their account; an
# address's failures lock only that address. Without the split, several members behind one
# office or household connection would lock each other out.
MEMBER_LOGIN_MAX_ATTEMPTS=5
MEMBER_LOGIN_MAX_ATTEMPTS_PER_IP=20

# Seconds. The window failures are counted over, and how long a lockout lasts.
MEMBER_LOGIN_WINDOW_SECONDS=900
MEMBER_LOGIN_LOCKOUT_SECONDS=900

# How long the attempt log is kept. Pruned on write, so the table cannot grow without bound.
MEMBER_LOGIN_ATTEMPT_RETENTION_DAYS=30

# Salt for hashing client IPs in member_login_attempts. Client addresses are stored as a
# salted SHA-256, never in the clear.
#
# SECRET. Leave this unset and it is derived from JWT_SECRET, which is a sound default: both
# are secrets of the same lifetime and rotating the JWT secret already signs everyone out.
# Set it explicitly only if the two must rotate independently. Changing it makes existing
# per-IP counts unmatchable, which fails open — a lockout is forgotten, never extended.
# LOGIN_IP_HASH_SALT=
