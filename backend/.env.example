# MPSS backend environment configuration.
#
# Copy this file to `backend/.env` and fill in real values for local development.
# `backend/.env` is gitignored and must never be committed.
# Deployed environments must set these in the hosting provider's environment
# configuration (e.g. Render dashboard), not in a file.
#
# The application refuses to start if any required variable is missing.

# --- Database (all required) ---
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# --- Auth (JWT_SECRET required) ---
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing this value invalidates every issued access token and forces all users to log in again.
JWT_SECRET=
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# --- Server (optional, defaults shown) ---
PORT=4000

# Comma-separated allow-list. Defaults to the known production and local origins
# when unset; override to change which frontends may call this API.
# CORS_ALLOWED_ORIGINS=https://example.com,http://localhost:5173
